{
    "name": "@diia-inhouse/configs",
    "version": "7.4.0",
    "type": "module",
    "description": "Shared node.js configurations",
    "repository": "https://github.com/diia-open-source/be-configs",
    "author": "Diia",
    "bin": {
        "protoc-gen-diia-ts": "./dist/protoc-gen-ts/index.js",
        "diia-buf-lint": "./buf/buf-lint.mjs",
        "diia-buf-breaking": "./buf/buf-breaking.mjs",
        "diia-clean": "./clean/clean.mjs"
    },
    "files": [
        "buf",
        "clean",
        "commitlint",
        "dist",
        "tsconfig/tsconfig.json"
    ],
    "engines": {
        "node": ">=22"
    },
    "scripts": {
        "build": "node clean/clean.mjs dist && tsc",
        "find-circulars": "madge --circular --extensions ts ./",
        "lint": "oxlint && oxfmt --check .",
        "lint-fix": "oxlint --fix && oxfmt .",
        "lint:lockfile": "lockfile-lint --path package-lock.json --allowed-hosts registry.npmjs.org --validate-https",
        "prepare": "npm run build",
        "semantic-release": "semantic-release",
        "test": "tsc --project tests/tsconfig.json --noEmit && vitest run",
        "test:watch": "vitest watch"
    },
    "commitlint": {
        "extends": "./commitlint/index.js"
    },
    "release": {
        "extends": "./dist/semantic-release/package.js"
    },
    "dependencies": {
        "@cleyrop-org/semantic-release-backmerge": "6.2.0",
        "@commitlint/cli": "21.2.4",
        "@commitlint/config-angular": "21.2.4",
        "@semantic-release/git": "11.0.1",
        "@semantic-release/gitlab": "13.3.5",
        "conventional-changelog-conventionalcommits": "9.3.1",
        "glob": "14.0.6",
        "protobufjs": "8.8.1",
        "semantic-release-slack-bot": "4.0.2",
        "ts-proto": "2.22.0"
    },
    "devDependencies": {
        "@types/node": "26.6.6",
        "@vitest/coverage-v8": "5.1.1",
        "madge": "8.0.0",
        "oxfmt": "0.79.0",
        "oxlint": "1.94.0",
        "semantic-release": "25.0.9",
        "typescript": "5.9.3",
        "vitest": "5.1.1"
    },
    "peerDependencies": {
        "semantic-release": "^24.0.0 || ^25.0.0",
        "typescript": "^5.7.0 || ^6.0.0 || ^7.0.0"
    },
    "license": "SEE LICENSE IN LICENSE.md"
}
