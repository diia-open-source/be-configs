{
    "name": "@diia-inhouse/configs",
    "version": "7.1.0",
    "type": "module",
    "description": "Shared node.js configurations",
    "repository": "https://github.com/diia-open-source/be-configs",
    "author": "Diia",
    "files": [
        "commitlint",
        "dist",
        "tsconfig/tsconfig.json"
    ],
    "engines": {
        "node": ">=22"
    },
    "scripts": {
        "prebuild": "rimraf dist",
        "build": "tsc",
        "find-circulars": "madge --circular --extensions ts ./",
        "lint": "oxlint && oxfmt --check .",
        "lint-fix": "oxlint --fix && oxfmt .",
        "lint:lockfile": "lockfile-lint --path package-lock.json --allowed-hosts registry.npmjs.org --validate-https",
        "prepare": "npm run build",
        "semantic-release": "semantic-release",
        "test": "vitest run",
        "test:watch": "vitest watch"
    },
    "commitlint": {
        "extends": "./commitlint/index.js"
    },
    "release": {
        "extends": "./dist/semantic-release/package.js"
    },
    "dependencies": {
        "@cleyrop-org/semantic-release-backmerge": "6.1.0",
        "@commitlint/cli": "19.8.0",
        "@commitlint/config-angular": "19.8.0",
        "@semantic-release/git": "10.0.1",
        "@semantic-release/gitlab": "13.3.2",
        "conventional-changelog-conventionalcommits": "8.0.0",
        "semantic-release-slack-bot": "4.0.2",
        "superstruct": "2.0.2",
        "yargs-parser": "22.0.0"
    },
    "devDependencies": {
        "@types/conventional-changelog-writer": "4.0.11",
        "@types/node": "24.10.0",
        "@vitest/coverage-v8": "4.1.8",
        "@vitest/ui": "4.1.8",
        "lockfile-lint": "5.0.0",
        "madge": "8.0.0",
        "oxfmt": "0.52.0",
        "oxlint": "1.67.0",
        "oxlint-tsgolint": "0.23.0",
        "rimraf": "6.1.3",
        "semantic-release": "25.0.8",
        "typescript": "5.9.3",
        "vite-tsconfig-paths": "6.1.1",
        "vitest": "4.1.8",
        "vitest-mock-extended": "4.0.0"
    },
    "peerDependencies": {
        "semantic-release": "^24.0.0 || ^25.0.0",
        "typescript": "^5.7.0 || ^6.0.0"
    },
    "license": "SEE LICENSE IN LICENSE.md"
}
